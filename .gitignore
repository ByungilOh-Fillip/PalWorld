# =============================================================
# PalSystem — Unreal Engine 5 C++ Multiplayer Project
# .gitignore
# 폴더 구조: palworld/ (root) > palworld/ (UE Project)
# =============================================================


# -------------------------------------------------------------
# [UE5] 빌드 산출물 — 로컬에서 자동 생성되므로 추적 불필요
# -------------------------------------------------------------

# 컴파일된 바이너리 (엔진이 빌드 시 자동 생성)
palworld/Binaries/
palworld/Plugins/**/Binaries/

# 중간 빌드 파일 (컴파일 캐시, 코드 생성 파일 포함)
palworld/Intermediate/
palworld/Plugins/**/Intermediate/

# 파생 데이터 캐시 (텍스처, 셰이더 캐시 — 용량 매우 큼)
palworld/DerivedDataCache/


# -------------------------------------------------------------
# [UE5] 에디터 저장 데이터 — 개인 환경 설정이므로 추적 불필요
# -------------------------------------------------------------

# 에디터 자동 저장, 로그, 크래시 덤프, 스크린샷 등
palworld/Saved/

# 단, 커스텀 Config는 팀 공유가 필요할 수 있으므로 선택적으로 허용
# 아래 주석을 해제하면 DefaultGame.ini 등을 추적할 수 있음
# !palworld/Saved/Config/Windows/


# -------------------------------------------------------------
# [UE5] 빌드 폴더 — 패키징 산출물
# -------------------------------------------------------------

palworld/Build/

# Build 폴더 내 PakBlacklist 파일은 추적 (패키징 설정)
!palworld/Build/*/
palworld/Build/*/**
!palworld/Build/*/PakBlacklist*.txt
!palworld/Build/**/*.ico


# -------------------------------------------------------------
# [UE5] 에셋 관련
# -------------------------------------------------------------

# 맵 빌드 데이터 (라이팅 빌드 결과 — 용량 크고 자동 생성)
palworld/**/*_BuiltData.uasset

# SourceArt 원본 이미지 (필요 시 LFS로 관리 권장)
palworld/SourceArt/**/*.png
palworld/SourceArt/**/*.tga


# -------------------------------------------------------------
# [IDE] Visual Studio
# -------------------------------------------------------------

.vs/
*.suo
*.user
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# 하위 폴더(PalWorld/) 내의 모든 sln 및 slnx 파일을 제외하도록 수정
**/*.sln
**/*.slnx


# -------------------------------------------------------------
# [Personal tools / local docs] 개인 작업 폴더 — dev에는 올리지 않음
# -------------------------------------------------------------

.agents/
.codex/
.cursor/
.mcp/
docs/
PalWorld/.gemini/
PalWorld/.mcp.json
PalWorld/Plugins/UnrealMCP/


# -------------------------------------------------------------
# [IDE] JetBrains Rider
# -------------------------------------------------------------

**/.idea/
**/*.DotSettings.user


# -------------------------------------------------------------
# [IDE] VSCode
# -------------------------------------------------------------

.vscode/


# -------------------------------------------------------------
# [OS] macOS
# -------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverrideDirectory
._*


# -------------------------------------------------------------
# [OS] Windows
# -------------------------------------------------------------

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# -------------------------------------------------------------
# [컴파일러] 오브젝트 파일 및 라이브러리
# -------------------------------------------------------------

*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app


# -------------------------------------------------------------
# [XCode] macOS 빌드 파일
# -------------------------------------------------------------

*.xcodeproj
*.xcworkspace


# -------------------------------------------------------------
# [UE5] 자동 생성 프로젝트 파일 — 추적 불필요
# (각자 로컬에서 GenerateProjectFiles로 생성)
# -------------------------------------------------------------

*.VC.db
*.VC.opendb


# =============================================================
# 추적해야 할 핵심 파일 (절대 ignore 되면 안 됨)
# =============================================================
# palworld/palworld.uproject       ← 프로젝트 메인 파일
# palworld/Config/                 ← 게임 설정 (DefaultGame.ini 등)
# palworld/Content/                ← 에셋 (.uasset, .umap)
# palworld/Source/                 ← C++ 소스 코드
# palworld/Plugins/**/Source/      ← 플러그인 소스
# palworld/Plugins/**/Content/     ← 플러그인 에셋
# =============================================================
*.slnx
*.sln
